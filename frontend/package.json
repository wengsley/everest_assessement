{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --names next,sync --prefix-colors cyan,magenta \"next dev -p 3001\" \"wait-on http://127.0.0.1:3001 && browser-sync start --config bs-config.cjs\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next build && next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
